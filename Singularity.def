Bootstrap: docker
From: nvcr.io/nvidia/pytorch:24.12-py3

%post
    pip install --no-cache-dir \
        numpy>=1.24.0 \
        pandas>=2.0.0 \
        scikit-learn>=1.3.0 \
        scipy>=1.11.0 \
        matplotlib>=3.7.0 \
        xgboost>=2.0.0

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    exec python "$@"

%labels
    Author ryanchoi
    Description autoresearch agent container for SLURM cluster (ATTR-CM classification)
